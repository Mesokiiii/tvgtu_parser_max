# ==============================================================================
# Файл конфигурации переменных окружения модуля прямого взаимодействия с ТвГТУ
# ==============================================================================

# 1. Параметры выгружаемого расписания
# ------------------------------------------------------------------------------
# Целевая академическая группа (магистратура 'М.', бакалавриат 'Б.', специалитет 'С.', колледж 'СПО.')
# Примеры: 'М.ПИН.РИС.25.09', 'Б.ПИН.ИИ.25.16', 'С.РСК.РСК.24.05'
SCHEDULE_GROUP=Б.ПИН.ИИ.25.16

# Персональное расписание преподавателя (если заполнено, группа игнорируется)
# Примеры: 'Пиджакова', 'Лебедев', 'Крутских', 'Созонов'
SCHEDULE_TEACHER=

# 2. Интеграция с CalDAV-сервером Radicale
# ------------------------------------------------------------------------------
# URL сервера Radicale. В Docker Compose используйте 'http://radicale:5232', на хосте 'http://localhost:5232'
RADICALE_URL=http://radicale:5232

# Учетные данные CalDAV
RADICALE_USER=tstu
RADICALE_PASSWORD=tstu_password
RADICALE_CALENDAR=schedule

# Флаги выгрузки (true/false)
EXPORT_RADICALE=true
EXPORT_ICS=true
EXPORT_EXCEL=true
EXPORT_JSON=true

# 3. Границы учебного семестра (для расчета чередования красных/синих недель)
# ------------------------------------------------------------------------------
SEMESTER_START_DATE=2026-09-01
SEMESTER_END_DATE=2027-01-31

# 4. Режимы работы сервиса
# ------------------------------------------------------------------------------
# Интервал периодической синхронизации в секундах (0 - разовый запуск и выход, 3600 - ежечасно)
SYNC_INTERVAL=0

# Запуск встроенного веб-сервера для просмотра интерактивного интерфейса web_viewer.html
RUN_SERVER=false
PORT=8081
